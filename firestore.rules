rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function artist() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function validArtwork() {
      return request.resource.data.keys().hasOnly([
        'title', 'description', 'year', 'medium', 'dimensions', 'price',
        'category', 'status', 'published', 'sortOrder', 'imageUrl',
        'imagePath', 'altText', 'createdAt', 'updatedAt'
      ]) &&
      request.resource.data.title is string &&
      request.resource.data.title.size() > 0 &&
      request.resource.data.title.size() <= 160 &&
      request.resource.data.imageUrl is string &&
      request.resource.data.imageUrl.size() > 0 &&
      request.resource.data.category in ['catalogue', 'featured', 'series'] &&
      request.resource.data.status in ['available', 'reserved', 'sold'] &&
      request.resource.data.published is bool &&
      request.resource.data.price is number &&
      request.resource.data.price >= 0;
    }
    function validSettings() {
      return request.resource.data.keys().hasOnly([
        'hero', 'bio', 'commissionPrice', 'whatsapp', 'email',
        'catalogueLive', 'updatedAt'
      ]) &&
      request.resource.data.hero is string &&
      request.resource.data.hero.size() <= 350 &&
      request.resource.data.bio is string &&
      request.resource.data.bio.size() <= 900 &&
      request.resource.data.commissionPrice is number &&
      request.resource.data.commissionPrice >= 0 &&
      request.resource.data.whatsapp is string &&
      request.resource.data.whatsapp.matches('^[0-9]{9,16}$') &&
      request.resource.data.email is string &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.catalogueLive is bool;
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /artworks/{artworkId} {
      allow get, list: if artist() || resource.data.published == true;
      allow create, update: if artist() && validArtwork();
      allow delete: if artist();
    }
    match /settings/{settingId} {
      allow get: if settingId == 'site' || artist();
      allow list: if artist();
      allow create, update: if settingId == 'site' && artist() && validSettings();
      allow delete: if false;
    }
    match /enquiries/{enquiryId} {
      allow get, list, update, delete: if artist();
      // Only the App Check-protected Admin SDK Cloud Function can create messages.
      allow create: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
