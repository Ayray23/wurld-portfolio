rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function artist() {
    return signedIn() &&
      exists(/databases/$(database)/documents/admins/$(request.auth.uid));
  }
  function artworkFields() {
    return request.resource.data.keys().hasOnly([
      'title','description','year','medium','dimensions','price','category',
      'status','published','sortOrder','imageUrl','imagePath','altText',
      'createdAt','updatedAt'
    ]) &&
    request.resource.data.title is string &&
    request.resource.data.title.size() > 0 &&
    request.resource.data.title.size() <= 160 &&
    request.resource.data.imageUrl is string &&
    request.resource.data.category in ['catalogue','featured','series'] &&
    request.resource.data.status in ['available','reserved','sold'] &&
    request.resource.data.published is bool &&
    request.resource.data.price is number &&
    request.resource.data.price >= 0;
  }
  match /admins/{uid} {
    allow get: if signedIn() && request.auth.uid == uid;
    allow list, create, update, delete: if false;
  }
  match /artworks/{id} {
    allow get,list: if artist() || resource.data.published == true;
    allow create,update: if artist() && artworkFields();
    allow delete: if artist();
  }
  match /settings/{id} {
    allow get: if id == "site" || artist();
    allow list: if artist();
    allow create, update: if id == "site" && artist() &&
      request.resource.data.keys().hasOnly([
        'hero','bio','commissionPrice','whatsapp','email','catalogueLive','updatedAt'
      ]) &&
      request.resource.data.hero is string &&
      request.resource.data.hero.size() <= 350 &&
      request.resource.data.bio is string &&
      request.resource.data.bio.size() <= 900 &&
      request.resource.data.commissionPrice is number &&
      request.resource.data.commissionPrice >= 0 &&
      request.resource.data.whatsapp is string &&
      request.resource.data.whatsapp.matches('^[0-9]{9,16}
    allow read,update,delete: if artist();
    // Enquiries are created ONLY by the App Check protected Cloud Function.
    // The Admin SDK bypasses these browser rules on the trusted server.
    allow create: if false;
  }
  match /{document=**} { allow read,write: if false; }
 }
}) &&
      request.resource.data.email is string &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.catalogueLive is bool;
    allow delete: if false;
  }
  match /enquiries/{id} {
    allow read,update,delete: if artist();
    // Public submission requires validated fields, but a public endpoint still
    // needs App Check and additional spam protection before large-scale use.
    allow create: if request.auth == null &&
      request.resource.data.keys().hasOnly(['name','email','interest','message','artworkId','status','createdAt']) &&
      request.resource.data.name is string &&
      request.resource.data.name.size() >= 2 &&
      request.resource.data.name.size() <= 100 &&
      request.resource.data.email is string &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.message is string &&
      request.resource.data.message.size() >= 10 &&
      request.resource.data.message.size() <= 2000 &&
      request.resource.data.interest is string &&
      request.resource.data.interest.size() <= 120 &&
      request.resource.data.artworkId is string &&
      request.resource.data.artworkId.size() <= 160 &&
      request.resource.data.status == 'new' &&
      request.resource.data.createdAt == request.time;
  }
  match /{document=**} { allow read,write: if false; }
 }
}