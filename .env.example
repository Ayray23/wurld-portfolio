# Enter in Vercel Project Settings → Environment Variables.
# These are Firebase WEB APP values, not Firebase Admin SDK secrets.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Required only when secure enquiry submission is enabled:
FIREBASE_APPCHECK_SITE_KEY=
